APP_NAME=Rathdrum CFR
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Europe/Dublin

SECRET_KEY=change-me-to-a-long-random-string

# Production must use MySQL (SQLite is only for local/testing).
DATABASE_URL=mysql+pymysql://rathdrumcfr:secret@127.0.0.1:3306/rathdrumcfr
LARAVEL_DATABASE_URL=mysql+pymysql://rathdrumcfr:secret@127.0.0.1:3306/rathdrumcfr_legacy

# Monthly report emails (1st of month, 09:00 Europe/Dublin). Set false to disable in-app scheduler.
SCHEDULER_ENABLED=true

SESSION_LIFETIME=120
SESSION_REMEMBER_LIFETIME=43200
SESSION_SECURE_COOKIE=false

ADMIN_EMAIL=admin@example.com
MAIL_FROM=noreply@example.com
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false

GOOGLE_MAPS_API_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
